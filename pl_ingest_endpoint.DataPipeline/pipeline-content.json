{
  "properties": {
    "activities": [
      {
        "type": "WebActivity",
        "typeProperties": {
          "method": "GET",
          "relativeUrl": {
            "value": "@concat(pipeline().parameters.relative_url, '&page=1')",
            "type": "Expression"
          },
          "headers": {
            "Authorization": {
              "value": "@concat('Bearer ', pipeline().parameters.tmdb_token)",
              "type": "Expression"
            }
          }
        },
        "externalReferences": {
          "connection": "322f3951-e5c4-4d12-8bed-dba1f3331cba"
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": true,
          "secureOutput": false
        },
        "name": "Get first page",
        "dependsOn": []
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "pages",
          "value": {
            "value": "@range(1, if(pipeline().parameters.is_paged, min(activity('Get first page').output.total_pages, pipeline().parameters.max_pages), 1))",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
